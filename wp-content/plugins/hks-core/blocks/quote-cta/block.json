{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hks/quote-cta",
  "version": "0.5.0",
  "title": "HKS quote request",
  "category": "widgets",
  "icon": "format-chat",
  "description": "Context-aware quote intake, private recovery record, review, and visitor-controlled WhatsApp or email handoff.",
  "textdomain": "hks-core",
  "attributes": {
    "location": {
      "type": "string",
      "default": "content"
    },
    "label": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "default": "quote"
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  }
}
