# HKS first-party static assets. HTML compression is handled conditionally by
# the theme because this directory-level file cannot affect WordPress routes.

# Map retired asset URLs to official artwork after deployment removes the files.
<IfModule mod_alias.c>
	Redirect 301 /wp-content/themes/hks-wayfinder/assets/images/brand/hks-wayfinder-horizontal-primary.svg /wp-content/themes/hks-wayfinder/assets/images/brand/holiday-kenya-safaris-logo.svg
	Redirect 301 /wp-content/themes/hks-wayfinder/assets/images/brand/hks-wayfinder-favicon.svg /wp-content/themes/hks-wayfinder/assets/images/brand/holiday-kenya-safaris-icon.svg
	Redirect 301 /wp-content/themes/hks-wayfinder/assets/images/brand/favicon-32.png /wp-content/themes/hks-wayfinder/assets/images/brand/holiday-kenya-safaris-favicon-32.png
	Redirect 301 /wp-content/themes/hks-wayfinder/assets/images/brand/site-icon-512.png /wp-content/themes/hks-wayfinder/assets/images/brand/holiday-kenya-safaris-site-icon-512.png
	Redirect 301 /wp-content/themes/hks-wayfinder/assets/images/brand/apple-touch-icon-180.png /wp-content/themes/hks-wayfinder/assets/images/brand/holiday-kenya-safaris-apple-touch-icon-180.png
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/css text/javascript application/javascript application/x-javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/avif "access plus 30 days"
	ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(?:css|js)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(?:svg|png|jpe?g|webp|avif)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "\.woff2$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>
